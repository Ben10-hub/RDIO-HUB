# RDIO AI Website Environment Variables

# Gemini API (chatbot) — copy to .env.local
GEMINI_API_KEY=

# Google Sheets Integration
# To enable dynamic content from Google Sheets:
# 1. Create a Google Sheet with your data
# 2. Publish each sheet to the web: File > Share > Publish to web
# 3. Choose "Comma-separated values (.csv)" format
# 4. Copy the URL and paste below

# Domains Sheet URL (CSV export)
NEXT_PUBLIC_DOMAINS_SHEET_URL=

# Programs Sheet URL (CSV export)
NEXT_PUBLIC_PROGRAMS_SHEET_URL=

# Events Sheet URL (CSV export)
NEXT_PUBLIC_EVENTS_SHEET_URL=

# Gallery Sheet URL (CSV export)
NEXT_PUBLIC_GALLERY_SHEET_URL=

# Note: If these URLs are not set, the website will use fallback data
# from the /data directory, which can be edited directly in code.
